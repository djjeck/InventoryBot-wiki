{
  "name": "inventorybot-wiki",
  "version": "0.9.3",
  "private": true,
  "description": "Genera una wiki per @InventoryBot basata sul tuo progresso personale",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check:universe": "node scripts/check-universe.ts",
    "typecheck": "tsc && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "golden:update": "node scripts/golden-update.ts",
    "inspect": "node --max-old-space-size=4096 scripts/inspect.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "ci": "npm run format:check && npm run lint && npm run check:universe && npm run typecheck && npm run test:coverage",
    "validate": "npm run format && npm run format:check && npm run lint:fix && npm run lint && npm run check:universe && npm run typecheck && npm run golden:update && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  }
}
